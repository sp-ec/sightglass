# --- Database ---
# DATABASE_URL takes priority over the discrete DB_* vars below.
# Managed providers (Railway, Heroku) supply it and need DB_SSL=true.
# DATABASE_URL=
# DB_SSL=true

DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=steamanalyzer

# --- Server ---
PORT=3001
# NODE_ENV=production

# --- Auth ---
# Cookies must not be Secure over plain HTTP or the browser discards them.
# Defaults to true when NODE_ENV=production; set explicitly to override.
# COOKIE_SECURE=true
# BCRYPT_ROUNDS=12
# Set to "false" to close public sign-ups. The one-time admin setup is
# unaffected; it is gated by the users table being empty.
# ALLOW_PUBLIC_SIGNUP=true

# --- Steam ---
STEAM_API_KEY=
