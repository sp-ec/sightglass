# --- Database ---
# DATABASE_URL takes priority over the discrete DB_* vars below.
# Managed providers (Railway, Heroku) supply it and need DB_SSL=true.
# DATABASE_URL=
# DB_SSL=true

DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=steamanalyzer

# --- Server ---
PORT=3001
# NODE_ENV=production

# --- Auth ---
# Cookies must not be Secure over plain HTTP or the browser discards them.
# Defaults to true when NODE_ENV=production; set explicitly to override.
# COOKIE_SECURE=true
# BCRYPT_ROUNDS=12

# --- Steam ---
# Only read once, to import an existing key into the database on first boot.
# After that the key lives in app settings and this var can be removed.
# STEAM_API_KEY=

# --- Moved into the app ---
# Public sign-ups and the Steam API key are now edited at
# Administration > App Settings, so ALLOW_PUBLIC_SIGNUP is no longer read.
# Sign-ups default to CLOSED on a new database.
